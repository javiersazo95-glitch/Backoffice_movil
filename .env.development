# Backend Spring Boot local (RespuesTop-mono-repo/backend), corriendo con
# SPRING_PROFILES_ACTIVE=dev,local en el puerto 8080.
#
# Reemplaza <COMPLETAR_IP_LAN> por la IP de tu PC en la red local (NO uses
# "localhost": el celular/emulador no puede resolverlo).
#
# Cómo obtener tu IP LAN:
#   Windows (PowerShell): ipconfig  -> busca "Dirección IPv4" del adaptador
#   activo (WiFi/Ethernet), ej. 192.168.1.14
#
# Si usas el emulador de Android Studio (no dispositivo físico), puedes usar
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1 en su lugar.
EXPO_PUBLIC_API_URL=http://192.168.1.14:8080/api/v1
