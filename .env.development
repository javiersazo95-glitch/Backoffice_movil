# Backend Spring Boot local (RespuesTop-mono-repo/backend), corriendo en el puerto 8080.
#
# Para pruebas locales desde la PC (Web / Navegador / Metro):
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Para pruebas desde un Celular Android físico en la misma red WiFi:
# EXPO_PUBLIC_API_URL=http://192.168.1.14:8080/api/v1

# Para pruebas desde el emulador de Android Studio:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1

# Servidor remoto Dev:
# EXPO_PUBLIC_API_URL=https://api-dev.repuestop.cl/api/v1
